# ─── Model Provider ───────────────────────────────────────────────
# fixture  = deterministic local demo (no API keys needed)
# ollama   = call the configured SLM through Ollama's /api/chat endpoint
# openai   = call OpenAI /chat/completions with Bearer API key
# openai-compatible = same as openai, but with a custom base URL
MODEL_PROVIDER=fixture

# Per-role model overrides. Leave as "fixture" to use the provider's default model.
GENERATOR_MODEL=fixture
JUDGE_MODEL=fixture
SOLVER_MODEL=fixture
REPAIR_MODEL=fixture

# ─── Ollama / SLM Settings ───────────────────────────────────────
OLLAMA_BASE_URL=https://your-ollama-host.example
OLLAMA_MODEL=qwen2.5:7b
# Cloudflare Access credentials (only if Ollama is behind CF Access)
OLLAMA_CF_ACCESS_CLIENT_ID=
OLLAMA_CF_ACCESS_CLIENT_SECRET=
OLLAMA_TIMEOUT_SECONDS=120
OLLAMA_JSON_RETRIES=2
OLLAMA_NUM_CTX=16384
OLLAMA_MCQ_NUM_PREDICT=1400
OLLAMA_PBQ_NUM_PREDICT=8192
OLLAMA_CODING_NUM_PREDICT=4200
OLLAMA_MCQ_BATCH_SIZE=8
OLLAMA_MAX_GENERATION_ATTEMPTS=2

# ─── OpenAI / OpenAI-Compatible Settings ─────────────────────────
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TIMEOUT_SECONDS=120
OPENAI_MAX_COMPLETION_TOKENS=4200

# ─── POC Runtime Settings ────────────────────────────────────────
POC_OUTPUT_DIR=outputs
POC_EXECUTION_TIMEOUT_SECONDS=60
